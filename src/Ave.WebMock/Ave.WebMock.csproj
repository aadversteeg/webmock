<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    
    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Package specific metadata -->
    <Description>A lightweight library for mocking web requests in unit tests, providing control over response timing, status codes, and content.</Description>
    <PackageTags>web;mock;testing;http;api</PackageTags>
    <IsPackable>true</IsPackable>
    
    <!-- Enable Deterministic Build for source link compatibility -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Package icon (uncomment and add path if you have an icon)
    <PackageIcon>icon.png</PackageIcon>
    -->
  </PropertyGroup>

  <!-- SourceLink is provided in Directory.Build.props -->
  
  <!-- Uncomment if you have an icon
  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  -->

</Project>