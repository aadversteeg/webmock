<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    
    <!-- Package specific metadata -->
    <Description>A lightweight library for mocking web requests in unit tests, providing control over response timing, status codes, and content.</Description>
    <PackageTags>web;mock;testing;http;api</PackageTags>
    <IsPackable>true</IsPackable>
    
    <!-- Package icon (uncomment and add path if you have an icon)
    <PackageIcon>icon.png</PackageIcon>
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>
  
  <!-- Uncomment if you have an icon
